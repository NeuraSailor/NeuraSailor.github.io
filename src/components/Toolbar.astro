---
/**
 * Toolbar —— 顶部工具栏（macOS 范式：前缘导航/站名，尾缘动作区）
 * HIG：图标不用文字、≥44×44 命中区、圆角与所在栏同心
 */
interface Props {
  title?: string;
}
const { title = 'NeuraSailor' } = Astro.props;
---

<header class="toolbar" id="toolbar">
  <div class="toolbar__leading">
    <button class="icon-btn" id="sidebarToggle" aria-label="切换侧边栏" aria-controls="sidebar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <rect x="3" y="4" width="18" height="16" rx="3.5"></rect>
        <line x1="9.5" y1="4" x2="9.5" y2="20"></line>
      </svg>
    </button>
    <a class="toolbar__title" href="/">
      {title}<span class="toolbar__subtitle">知识花园</span>
    </a>
  </div>

  <div class="toolbar__trailing">
    <button class="icon-btn icon-btn--search" id="searchToggle" aria-label="搜索">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
      </svg>
      <span>搜索</span><kbd>⌘K</kbd>
    </button>
    <button class="icon-btn" id="skinToggle" aria-label="选择界面皮肤" aria-haspopup="menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3a9 9 0 0 0 0 18c1.2 0 2-.8 2-1.8 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-1 .8-1.8 1.8-1.8H17a4 4 0 0 0 4-4c0-4.4-4-8-9-8z"></path>
        <circle cx="7.6" cy="11.2" r="0.7" fill="currentColor" stroke="none"></circle>
        <circle cx="10.6" cy="7.6" r="0.7" fill="currentColor" stroke="none"></circle>
        <circle cx="14.9" cy="7.9" r="0.7" fill="currentColor" stroke="none"></circle>
      </svg>
    </button>
    <button class="icon-btn" id="themeToggle" aria-label="切换明暗模式">
      <svg class="ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4.2"></circle>
        <path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5 5l1.7 1.7M17.3 17.3 19 19M19 5l-1.7 1.7M6.7 17.3 5 19"></path>
      </svg>
      <svg class="ico-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.5 14.2A8.6 8.6 0 0 1 9.8 3.5a8.6 8.6 0 1 0 10.7 10.7Z"></path>
      </svg>
    </button>
    <a class="icon-btn icon-btn--github" href="https://github.com/NeuraSailor" aria-label="GitHub 主页" rel="noopener">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.17c-3.2.7-3.87-1.36-3.87-1.36-.53-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.05.78 2.12v3.14c0 .31.21.67.8.55A11.52 11.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"></path>
      </svg>
    </a>
  </div>

  <div class="progress" aria-hidden="true">
    <div class="progress__bar" id="progressBar"></div>
  </div>
</header>
