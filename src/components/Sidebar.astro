---
/**
 * Sidebar —— 左侧玻璃导航栏（桌面常驻 / 移动抽屉）
 */
import { getCollection } from 'astro:content';
import { buildNavTree, ancestorSet } from '../lib/nav-tree';
import SidebarNode from './SidebarNode.astro';

interface Props {
  currentSlug?: string;
}
const { currentSlug = '' } = Astro.props;

const entries = await getCollection('docs');
const slugs = entries.map((e) => e.id);
const tree = buildNavTree(slugs);
const openTrail = ancestorSet(currentSlug);
---

<aside class="sidebar" id="sidebar" aria-label="站点目录">
  <div class="sidebar__scroll">
    {tree.map((section) => <SidebarNode node={section} pathKey={section.name} currentSlug={currentSlug} openTrail={openTrail} />)}
  </div>
</aside>
